# Copy this file to ".env.admin" (same folder), fill it in, run:  npm run create-admin:remote
# Then DELETE .env.admin. It holds your database password and is never committed.

# Must be the SAME database Render uses (note the database name after .mongodb.net/)
MONGODB_URI=mongodb+srv://USER:PASSWORD@stylecheck-prod-1.6lunwk2.mongodb.net/stylecheck_staging?retryWrites=true&w=majority

# The admin account to create
ADMIN_EMAIL=you@example.com
ADMIN_NAME=Your Name
ADMIN_PASSWORD=choose-a-strong-password

# Do not change these: the app only checks that they exist
NODE_ENV=staging
FRONTEND_URL=https://stylecheck-gxewy.ondigitalocean.app
JWT_SECRET=placeholder-not-used-by-this-script-0123456789
GEMINI_API_KEY=placeholder
BREVO_API_KEY=placeholder
BREVO_SENDER_EMAIL=placeholder@example.com
