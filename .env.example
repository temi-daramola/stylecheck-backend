PORT=5000
NODE_ENV=development
LOG_LEVEL=info

MONGODB_URI=mongodb://127.0.0.1:27017/stylecheck_dev
FRONTEND_URL=http://localhost:5173

JWT_SECRET=your-jwt-secret-min-32-characters
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=30

GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash-lite

MAX_MANUAL_TEXT_LENGTH=500000

BREVO_API_KEY=your-brevo-api-key
BREVO_SENDER_EMAIL=noreply@stylecheck.com.ng
BREVO_SENDER_NAME=StyleCheck

MAX_DOC_SIZE_MB=50
UPLOAD_DIR=./uploads
# PYTHON_BIN defaults to "python" on Windows and "python3" elsewhere

# Optional: create the first administrator on startup when none exists (then remove these)
# INITIAL_ADMIN_EMAIL=you@example.com
# INITIAL_ADMIN_PASSWORD=a-strong-password
# INITIAL_ADMIN_NAME=Administrator
